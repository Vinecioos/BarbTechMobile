# Copie para .env (o .env NUNCA vai para o Git). Nenhum destes valores tem padrão: sem eles o serviço não inicia.

# Origens do app que podem chamar este serviço (separadas por vírgula)
ALLOWED_ORIGINS=https://localhost,capacitor://localhost,http://localhost:5173

# Chave de criptografia (AES-256, 32 bytes em base64). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHAVE_CRIPTO=troque-por-uma-chave-gerada

# Segredo usado para pseudonimizar e-mails nos logs de auditoria (qualquer texto longo e aleatório)
CHAVE_LOG=troque-por-um-segredo-longo

# Conta de serviço do Firebase (Console > Configurações do projeto > Contas de serviço > Gerar nova chave privada).
# Guarde o arquivo fora da pasta do projeto ou no .gitignore.
FIREBASE_SERVICE_ACCOUNT=./conta-servico.json

# Envio do e-mail com o código OTP. Exemplo: smtps://usuario:senha@smtp.seuprovedor.com:465
# Para DEMONSTRAÇÃO em sala (sem provedor de e-mail), use SMTP_URL=console: o e-mail aparece no terminal. Nunca em produção.
SMTP_URL=troque-pelo-smtp
EMAIL_REMETENTE="BarbTech <nao-responda@seudominio.com>"

# Opcionais
PORT=3100
TRUST_PROXY=0
DIR_LOGS=./logs
DIR_BACKUP=./backups
BACKUP_ATIVO=1
BACKUP_HORA=3
BACKUP_RETENCAO_DIAS=14
