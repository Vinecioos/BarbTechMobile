<mxfile host="app.diagrams.net" agent="BarbTech" version="24.0.0"><diagram id="arq" name="1 Arquitetura"><mxGraphModel dx="1500" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="arqc2" value="&lt;b&gt;CAMADA DE APRESENTAÇÃO — aparelho do usuário&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#b9770e;strokeColor=#b9770e;fillColor=#fff8ec;" vertex="1" connectable="0" parent="1"><mxGeometry x="10" y="85" width="1480" height="175" as="geometry"/></mxCell><mxCell id="arqc3" value="&lt;b&gt;CAMADA DE BORDA — servidor web e autenticação&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#1f6fb2;strokeColor=#1f6fb2;fillColor=#eef6fd;" vertex="1" connectable="0" parent="1"><mxGeometry x="10" y="275" width="1480" height="125" as="geometry"/></mxCell><mxCell id="arqc4" value="&lt;b&gt;CAMADA DE APLICAÇÃO&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#1e8449;strokeColor=#1e8449;fillColor=#f1faf4;" vertex="1" connectable="0" parent="1"><mxGeometry x="10" y="415" width="1480" height="285" as="geometry"/></mxCell><mxCell id="arqc5" value="&lt;b&gt;CAMADA DE DADOS&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#1f6fb2;strokeColor=#1f6fb2;fillColor=#eef6fd;" vertex="1" connectable="0" parent="1"><mxGeometry x="10" y="715" width="1480" height="140" as="geometry"/></mxCell><mxCell id="arqc6" value="&lt;b&gt;SERVIÇOS EXTERNOS&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#7d3c98;strokeColor=#7d3c98;fillColor=#f6effa;" vertex="1" connectable="0" parent="1"><mxGeometry x="10" y="870" width="1480" height="130" as="geometry"/></mxCell><mxCell id="arqc7" value="&lt;b&gt;BarbTech — Arquitetura do sistema&lt;/b&gt;" style="text;html=1;align=left;fontSize=18;" vertex="1" connectable="0" parent="1"><mxGeometry x="1050" y="12" width="440" height="30" as="geometry"/></mxCell><mxCell id="arqc8" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;&lt;font color="#111"&gt;Usuário&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:11px;color:#333333"&gt;cliente ou profissional (titular dos dados)&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;strokeColor=#333;fillColor=#fff;strokeWidth=2;" vertex="1" connectable="1" parent="1"><mxGeometry x="60" y="125" width="240" height="70" as="geometry"/></mxCell><mxCell id="arqc9" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;&lt;font color="#111"&gt;User Browser — App BarbTech&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:11px;color:#333333"&gt;Interface HTML/JS dentro do WebView Capacitor (Android/iOS) ou navegador&lt;br&gt;Entradas: E1 formulários (cadastro, perfil, agendamento) · E2 login e recuperação · E7 foto/banner&lt;br&gt;Validação de entrada, escape de saída, CSP, senha forte, bloqueio local, sessão de 15 min&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;strokeColor=#b9770e;fillColor=#fff;strokeWidth=2;" vertex="1" connectable="1" parent="1"><mxGeometry x="380" y="120" width="740" height="125" as="geometry"/></mxCell><mxCell id="arqc10" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;Armazenamento local&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:center;font-size:11px;color:#333333"&gt;sessão, última atividade,&lt;br&gt;falhas de login, cache de CEP&lt;/div&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;strokeColor=#b9770e;fillColor=#fff;strokeWidth=2;verticalAlign=middle;" vertex="1" connectable="1" parent="1"><mxGeometry x="1180" y="120" width="260" height="110" as="geometry"/></mxCell><mxCell id="arqc11" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;&lt;font color="#111"&gt;Servidor web / borda — Google Front End + Firebase Auth&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:11px;color:#333333"&gt;Termina o TLS (HTTPS) · Firebase Authentication: senha (scrypt) e Google (OAuth 2.0/OIDC)&lt;br&gt;Emite ID token (JWT) usado em todas as chamadas · E3 login · E4 SDK do Firestore&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;strokeColor=#1f6fb2;fillColor=#fff;strokeWidth=2;" vertex="1" connectable="1" parent="1"><mxGeometry x="380" y="295" width="620" height="90" as="geometry"/></mxCell><mxCell id="arqc12" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;&lt;font color="#111"&gt;BrasilAPI / ViaCEP / OSM&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:11px;color:#333333"&gt;E6 recebem só CEP e cidade&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;strokeColor=#7d3c98;fillColor=#fff;strokeWidth=2;" vertex="1" connectable="1" parent="1"><mxGeometry x="1180" y="295" width="260" height="90" as="geometry"/></mxCell><mxCell id="arqc13" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;&lt;font color="#111"&gt;Serviço de segurança (opcional)&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:11px;color:#333333"&gt;E5 /api/seg/* · OTP por e-mail&lt;br&gt;Bloqueio de login entre aparelhos&lt;br&gt;Auditoria com hash encadeado&lt;br&gt;Rate limit, helmet, CORS por lista&lt;br&gt;zod: valida todo corpo&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;strokeColor=#1e8449;fillColor=#fff;strokeWidth=2;" vertex="1" connectable="1" parent="1"><mxGeometry x="60" y="455" width="320" height="220" as="geometry"/></mxCell><mxCell id="arqc14" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;&lt;font color="#111"&gt;Regras de segurança do Firestore&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:11px;color:#333333"&gt;Autorização por documento&lt;br&gt;Só o dono lê e altera o que é seu&lt;br&gt;Profissional não lê perfil de outro profissional&lt;br&gt;Limites de tamanho dos campos&lt;br&gt;Coleção recuperacao: cofre criptografado&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;strokeColor=#1e8449;fillColor=#fff;strokeWidth=2;" vertex="1" connectable="1" parent="1"><mxGeometry x="420" y="455" width="320" height="220" as="geometry"/></mxCell><mxCell id="arqc15" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;&lt;font color="#111"&gt;Backend do assistente (Node)&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:11px;color:#333333"&gt;E8 /api/chat&lt;br&gt;zod estrito, moderação&lt;br&gt;limites 10/min, 80/h e teto diário&lt;br&gt;chave da OpenAI só no .env&lt;br&gt;PENDENTE: conferir login Firebase&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;strokeColor=#1e8449;fillColor=#fff;strokeWidth=2;" vertex="1" connectable="1" parent="1"><mxGeometry x="780" y="455" width="300" height="220" as="geometry"/></mxCell><mxCell id="arqc16" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;&lt;font color="#111"&gt;Cloud Function&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:11px;color:#333333"&gt;notificações push (FCM)&lt;br&gt;dispara quando o agendamento muda&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;strokeColor=#1e8449;fillColor=#fff;strokeWidth=2;" vertex="1" connectable="1" parent="1"><mxGeometry x="1180" y="455" width="260" height="220" as="geometry"/></mxCell><mxCell id="arqc17" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;Backups e logs&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:center;font-size:11px;color:#333333"&gt;arquivos cifrados (AES-256-GCM)&lt;br&gt;PENDENTE: copiar para fora&lt;/div&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;strokeColor=#7d3c98;fillColor=#fff;strokeWidth=2;verticalAlign=middle;" vertex="1" connectable="1" parent="1"><mxGeometry x="60" y="740" width="300" height="90" as="geometry"/></mxCell><mxCell id="arqc18" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;Cloud Firestore (banco de dados)&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:center;font-size:11px;color:#333333"&gt;agendamentos, perfis, consentimentos&lt;br&gt;criptografia em repouso (Google)&lt;/div&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;strokeColor=#1f6fb2;fillColor=#fff;strokeWidth=2;verticalAlign=middle;" vertex="1" connectable="1" parent="1"><mxGeometry x="420" y="740" width="320" height="100" as="geometry"/></mxCell><mxCell id="arqc19" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;&lt;font color="#111"&gt;Provedor de e-mail&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:11px;color:#333333"&gt;entrega o código OTP&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;strokeColor=#7d3c98;fillColor=#fff;strokeWidth=2;" vertex="1" connectable="1" parent="1"><mxGeometry x="420" y="895" width="260" height="80" as="geometry"/></mxCell><mxCell id="arqc20" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;&lt;font color="#111"&gt;OpenAI (EUA)&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:11px;color:#333333"&gt;recebe o texto do chat,&lt;br&gt;sem CPF, telefone ou endereço&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;strokeColor=#7d3c98;fillColor=#fff;strokeWidth=2;" vertex="1" connectable="1" parent="1"><mxGeometry x="780" y="895" width="300" height="80" as="geometry"/></mxCell><mxCell id="arqc21" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;&lt;font color="#111"&gt;Firebase Cloud Messaging&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:11px;color:#333333"&gt;entrega o aviso no celular&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;strokeColor=#7d3c98;fillColor=#fff;strokeWidth=2;" vertex="1" connectable="1" parent="1"><mxGeometry x="1180" y="895" width="260" height="80" as="geometry"/></mxCell><mxCell id="arqe1" value="toque e teclado" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#333333;fontSize=11;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.32;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="arqc8" target="arqc9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arqe2" value="localStorage" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#333333;fontSize=11;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.44;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="arqc9" target="arqc10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arqe3" value="HTTPS/TLS: login e SDK do Firestore (JWT)" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#333333;fontSize=11;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.4189;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="arqc9" target="arqc11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arqe4" value="HTTPS GET (CEP)" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#333333;fontSize=11;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.9189;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="arqc9" target="arqc12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="340"/></Array></mxGeometry></mxCell><mxCell id="arqe5" value="HTTPS REST/JSON + token" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#333333;fontSize=11;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.0;exitY=0.84;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.4773;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="arqc9" target="arqc13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="225"/><mxPoint x="30" y="560"/></Array></mxGeometry></mxCell><mxCell id="arqe6" value="HTTPS POST /api/chat" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#333333;fontSize=11;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.68;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0;entryY=0.4773;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="arqc9" target="arqc15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="205"/><mxPoint x="1130" y="560"/></Array></mxGeometry></mxCell><mxCell id="arqe7" value="SDK Firestore: pedido autorizado?" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#333333;fontSize=11;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.3226;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="arqc11" target="arqc14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arqe8" value="leitura e escrita permitidas" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#333333;fontSize=11;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="arqc14" target="arqc18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arqe9" value="Admin SDK (gRPC/TLS)" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#333333;fontSize=11;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0938;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="arqc13" target="arqc18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="693"/><mxPoint x="450" y="693"/></Array></mxGeometry></mxCell><mxCell id="arqe10" value="arquivo de backup" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#333333;fontSize=11;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.2188;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.2333;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="arqc13" target="arqc17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arqe11" value="SMTP/TLS: código" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#333333;fontSize=11;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.6591;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="arqc13" target="arqc19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="395" y="600"/><mxPoint x="395" y="935"/></Array></mxGeometry></mxCell><mxCell id="arqe12" value="HTTPS: chat" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#333333;fontSize=11;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="arqc15" target="arqc20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arqe13" value="Admin SDK (gatilho)" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#333333;fontSize=11;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.2308;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.875;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="arqc16" target="arqc18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="707"/><mxPoint x="700" y="707"/></Array></mxGeometry></mxCell><mxCell id="arqe14" value="HTTPS: push" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#333333;fontSize=11;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.6154;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.6154;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="arqc16" target="arqc21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arqc22" value="Seta cinza = fluxo de dados, com o protocolo no rótulo · E1 a E8 = pontos de entrada de dados&lt;br&gt;As camadas seguem o modelo navegador → servidor web → aplicação → banco de dados; no BarbTech o servidor web é a borda do Google/Firebase." style="text;html=1;align=left;fontSize=11;fontColor=#444444;whiteSpace=wrap;" vertex="1" connectable="0" parent="1"><mxGeometry x="10" y="1030" width="1400" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tm" name="2 Modelagem de ameaças"><mxGraphModel dx="1500" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tmc2" value="&lt;b&gt;CAMADA DE APRESENTAÇÃO — aparelho do usuário (NÃO CONFIÁVEL)&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#b9770e;strokeColor=#b9770e;fillColor=#fff8ec;" vertex="1" connectable="0" parent="1"><mxGeometry x="10" y="85" width="1480" height="175" as="geometry"/></mxCell><mxCell id="tmc3" value="&lt;b&gt;CAMADA DE BORDA — servidor web e autenticação (Google, CONFIÁVEL)&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#1f6fb2;strokeColor=#1f6fb2;fillColor=#eef6fd;" vertex="1" connectable="0" parent="1"><mxGeometry x="10" y="275" width="1480" height="125" as="geometry"/></mxCell><mxCell id="tmc4" value="&lt;b&gt;CAMADA DE APLICAÇÃO (regras do Firebase: Google · serviços Node: grupo)&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#1e8449;strokeColor=#1e8449;fillColor=#f1faf4;" vertex="1" connectable="0" parent="1"><mxGeometry x="10" y="415" width="1480" height="285" as="geometry"/></mxCell><mxCell id="tmc5" value="&lt;b&gt;CAMADA DE DADOS&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#1f6fb2;strokeColor=#1f6fb2;fillColor=#eef6fd;" vertex="1" connectable="0" parent="1"><mxGeometry x="10" y="715" width="1480" height="140" as="geometry"/></mxCell><mxCell id="tmc6" value="&lt;b&gt;SERVIÇOS EXTERNOS (TERCEIROS)&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fontSize=11;fontColor=#7d3c98;strokeColor=#7d3c98;fillColor=#f6effa;" vertex="1" connectable="0" parent="1"><mxGeometry x="10" y="870" width="1480" height="130" as="geometry"/></mxCell><mxCell id="tmc7" value="&lt;b&gt;BarbTech — Modelagem de ameaças&lt;/b&gt;" style="text;html=1;align=left;fontSize=18;" vertex="1" connectable="0" parent="1"><mxGeometry x="1050" y="12" width="440" height="30" as="geometry"/></mxCell><mxCell id="tmc8" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;&lt;font color="#111"&gt;Usuário&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:11px;color:#333333"&gt;cliente ou profissional (titular dos dados)&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;strokeColor=#333;fillColor=#fff;strokeWidth=2;" vertex="1" connectable="1" parent="1"><mxGeometry x="60" y="125" width="240" height="70" as="geometry"/></mxCell><mxCell id="tmc9" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;&lt;font color="#111"&gt;User Browser — App BarbTech&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:11px;color:#333333"&gt;Interface HTML/JS dentro do WebView Capacitor (Android/iOS) ou navegador&lt;br&gt;Entradas: E1 formulários (cadastro, perfil, agendamento) · E2 login e recuperação · E7 foto/banner&lt;br&gt;Validação de entrada, escape de saída, CSP, senha forte, bloqueio local, sessão de 15 min&lt;br&gt;Dados tratados: e-mail, telefone, CPF/CNPJ, endereço, condição do cliente (saúde)&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;strokeColor=#b9770e;fillColor=#fff;strokeWidth=2;" vertex="1" connectable="1" parent="1"><mxGeometry x="380" y="120" width="740" height="125" as="geometry"/></mxCell><mxCell id="tmc10" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;Armazenamento local&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:center;font-size:11px;color:#333333"&gt;sessão, última atividade,&lt;br&gt;falhas de login, cache de CEP&lt;/div&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;strokeColor=#b9770e;fillColor=#fff;strokeWidth=2;verticalAlign=middle;" vertex="1" connectable="1" parent="1"><mxGeometry x="1180" y="120" width="260" height="110" as="geometry"/></mxCell><mxCell id="tmc11" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;&lt;font color="#111"&gt;Servidor web / borda — Google Front End + Firebase Auth&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:11px;color:#333333"&gt;Termina o TLS (HTTPS) · Firebase Authentication: senha (scrypt) e Google (OAuth 2.0/OIDC)&lt;br&gt;Emite ID token (JWT) usado em todas as chamadas · E3 login · E4 SDK do Firestore&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;strokeColor=#1f6fb2;fillColor=#fff;strokeWidth=2;" vertex="1" connectable="1" parent="1"><mxGeometry x="380" y="295" width="620" height="90" as="geometry"/></mxCell><mxCell id="tmc12" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;&lt;font color="#111"&gt;BrasilAPI / ViaCEP / OSM&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:11px;color:#333333"&gt;E6 recebem só CEP e cidade&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;strokeColor=#7d3c98;fillColor=#fff;strokeWidth=2;" vertex="1" connectable="1" parent="1"><mxGeometry x="1180" y="295" width="260" height="90" as="geometry"/></mxCell><mxCell id="tmc13" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;&lt;font color="#111"&gt;Serviço de segurança (opcional)&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:11px;color:#333333"&gt;E5 /api/seg/* · OTP por e-mail&lt;br&gt;Bloqueio de login entre aparelhos&lt;br&gt;Auditoria com hash encadeado&lt;br&gt;Rate limit, helmet, CORS por lista&lt;br&gt;zod: valida todo corpo&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;strokeColor=#1e8449;fillColor=#fff;strokeWidth=2;" vertex="1" connectable="1" parent="1"><mxGeometry x="60" y="455" width="320" height="220" as="geometry"/></mxCell><mxCell id="tmc14" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;&lt;font color="#111"&gt;Regras de segurança do Firestore&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:11px;color:#333333"&gt;Autorização por documento&lt;br&gt;Só o dono lê e altera o que é seu&lt;br&gt;Profissional não lê perfil de outro profissional&lt;br&gt;Limites de tamanho dos campos&lt;br&gt;Coleção recuperacao: cofre criptografado&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;strokeColor=#1e8449;fillColor=#fff;strokeWidth=2;" vertex="1" connectable="1" parent="1"><mxGeometry x="420" y="455" width="320" height="220" as="geometry"/></mxCell><mxCell id="tmc15" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;&lt;font color="#111"&gt;Backend do assistente (Node)&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:11px;color:#333333"&gt;E8 /api/chat&lt;br&gt;zod estrito, moderação&lt;br&gt;limites 10/min, 80/h e teto diário&lt;br&gt;chave da OpenAI só no .env&lt;br&gt;PENDENTE: conferir login Firebase&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;strokeColor=#1e8449;fillColor=#fff;strokeWidth=2;" vertex="1" connectable="1" parent="1"><mxGeometry x="780" y="455" width="300" height="220" as="geometry"/></mxCell><mxCell id="tmc16" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;&lt;font color="#111"&gt;Cloud Function&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:11px;color:#333333"&gt;notificações push (FCM)&lt;br&gt;dispara quando o agendamento muda&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;strokeColor=#1e8449;fillColor=#fff;strokeWidth=2;" vertex="1" connectable="1" parent="1"><mxGeometry x="1180" y="455" width="260" height="220" as="geometry"/></mxCell><mxCell id="tmc17" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;Backups e logs&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:center;font-size:11px;color:#333333"&gt;arquivos cifrados (AES-256-GCM)&lt;br&gt;PENDENTE: copiar para fora&lt;/div&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;strokeColor=#7d3c98;fillColor=#fff;strokeWidth=2;verticalAlign=middle;" vertex="1" connectable="1" parent="1"><mxGeometry x="60" y="740" width="300" height="90" as="geometry"/></mxCell><mxCell id="tmc18" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;Cloud Firestore (banco de dados)&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:center;font-size:11px;color:#333333"&gt;Dados sensíveis: CPF/CNPJ, endereço,&lt;br&gt;condição do cliente (saúde), telefone&lt;br&gt;criptografia em repouso (Google)&lt;/div&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;strokeColor=#1f6fb2;fillColor=#fff;strokeWidth=2;verticalAlign=middle;" vertex="1" connectable="1" parent="1"><mxGeometry x="420" y="740" width="320" height="100" as="geometry"/></mxCell><mxCell id="tmc19" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;&lt;font color="#111"&gt;Provedor de e-mail&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:11px;color:#333333"&gt;entrega o código OTP&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;strokeColor=#7d3c98;fillColor=#fff;strokeWidth=2;" vertex="1" connectable="1" parent="1"><mxGeometry x="420" y="895" width="260" height="80" as="geometry"/></mxCell><mxCell id="tmc20" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;&lt;font color="#111"&gt;OpenAI (EUA)&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:11px;color:#333333"&gt;recebe o texto do chat,&lt;br&gt;sem CPF, telefone ou endereço&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;strokeColor=#7d3c98;fillColor=#fff;strokeWidth=2;" vertex="1" connectable="1" parent="1"><mxGeometry x="780" y="895" width="300" height="80" as="geometry"/></mxCell><mxCell id="tmc21" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;&lt;font color="#111"&gt;Firebase Cloud Messaging&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:11px;color:#333333"&gt;entrega o aviso no celular&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;strokeColor=#7d3c98;fillColor=#fff;strokeWidth=2;" vertex="1" connectable="1" parent="1"><mxGeometry x="1180" y="895" width="260" height="80" as="geometry"/></mxCell><mxCell id="tmc22" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;&lt;font color="#c0392b"&gt;Quem pega o celular&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:11px;color:#333333"&gt;aparelho aberto ou perdido&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;strokeColor=#c0392b;fillColor=#fdecea;strokeWidth=2;" vertex="1" connectable="1" parent="1"><mxGeometry x="380" y="10" width="250" height="52" as="geometry"/></mxCell><mxCell id="tmc23" value='&lt;div style="text-align:center"&gt;&lt;b style="font-size:13px"&gt;&lt;font color="#c0392b"&gt;Atacante remoto (internet)&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:11px;color:#333333"&gt;usa o app ou chama as APIs direto&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=6;spacingTop=4;strokeColor=#c0392b;fillColor=#fdecea;strokeWidth=2;" vertex="1" connectable="1" parent="1"><mxGeometry x="700" y="10" width="330" height="52" as="geometry"/></mxCell><mxCell id="tme1" value="toque e teclado" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#333333;fontSize=11;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.32;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="tmc8" target="tmc9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tme2" value="localStorage" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.2;strokeColor=#333333;fontSize=11;fontStyle=2;fontColor=#333333;labelBack