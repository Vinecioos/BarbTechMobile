# Copie para .env (que NUNCA deve ir para o Git) e preencha.
OPENAI_API_KEY=cole_aqui_a_NOVA_chave
OPENAI_MODEL=gpt-4o-mini
# Origens autorizadas a chamar a API, separadas por vírgula.
#   https://localhost      -> app Android (Capacitor)
#   capacitor://localhost  -> app iOS (Capacitor)
#   http://localhost:5500  -> testes no navegador do computador
ALLOWED_ORIGINS=https://localhost,capacitor://localhost,http://localhost:5500
PORT=3000
# Limite global de chamadas por dia (trava de custo)
DAILY_REQUEST_CAP=2000
# Atrás de proxy/Render/Heroku/Nginx use 1; local use 0
TRUST_PROXY=0
